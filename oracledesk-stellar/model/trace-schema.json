{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracledesk.dev/schemas/system-model-trace-v1.json",
  "title": "OracleDesk stateful system-model trace",
  "description": "Versioned operation trace replayed by model/system_model.py and executed against the wasm contracts by contracts/integration-tests/tests/system_model.rs.",
  "type": "object",
  "required": ["schema_version", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "snapshots": {
      "type": "array",
      "description": "Optional committed snapshots; when present the model and the wasm harness must both reproduce them exactly.",
      "items": { "$ref": "#/$defs/snapshot" }
    },
    "resolution_fixture": {
      "$ref": "#/$defs/resolution_fixture",
      "description": "Optional sanitized, deterministic resolution-lifecycle event replay. Additive to schema_version 1: existing traces without this property remain valid and unchanged."
    }
  },
  "$defs": {
    "actor": { "enum": ["creator", "trader"] },
    "outcome": { "enum": ["yes", "no"] },
    "time": { "type": "integer", "minimum": 0 },
    "amount": { "type": "integer", "minimum": 1 },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "time", "close_time", "yes_bps"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "create" },
            "time": { "$ref": "#/$defs/time" },
            "close_time": { "$ref": "#/$defs/time" },
            "yes_bps": { "type": "integer", "minimum": 100, "maximum": 9900 }
          }
        },
        {
          "type": "object",
          "required": ["op", "time", "actor", "outcome", "amount"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "buy" },
            "time": { "$ref": "#/$defs/time" },
            "actor": { "$ref": "#/$defs/actor" },
            "outcome": { "$ref": "#/$defs/outcome" },
            "amount": { "$ref": "#/$defs/amount" }
          }
        },
        {
          "type": "object",
          "required": ["op", "time", "actor", "outcome", "collateral_out"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "sell" },
            "time": { "$ref": "#/$defs/time" },
            "actor": { "$ref": "#/$defs/actor" },
            "outcome": { "$ref": "#/$defs/outcome" },
            "collateral_out": { "$ref": "#/$defs/amount" }
          }
        },
        {
          "type": "object",
          "required": ["op", "time", "outcome", "amount"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "treasury_buy" },
            "time": { "$ref": "#/$defs/time" },
            "outcome": { "$ref": "#/$defs/outcome" },
            "amount": { "$ref": "#/$defs/amount" }
          }
        },
        {
          "type": "object",
          "required": ["op", "time", "outcome"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "resolve" },
            "time": { "$ref": "#/$defs/time" },
            "outcome": { "$ref": "#/$defs/outcome" }
          }
        },
        {
          "type": "object",
          "required": ["op", "time", "actor"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "redeem" },
            "time": { "$ref": "#/$defs/time" },
            "actor": { "$ref": "#/$defs/actor" }
          }
        },
        {
          "type": "object",
          "required": ["op", "time"],
          "additionalProperties": false,
          "properties": {
            "op": { "enum": ["claim_remainder", "sweep_fees", "publish_trace", "advance_time"] },
            "time": { "$ref": "#/$defs/time" }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "required": ["market", "positions", "balances", "resolver_state", "trace_count", "market_trace_count"],
      "additionalProperties": false,
      "properties": {
        "market": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["reserve_yes", "reserve_no", "sets_minted", "fees_accrued", "lp_claimed", "status"],
              "additionalProperties": false,
              "properties": {
                "reserve_yes": { "type": "integer" },
                "reserve_no": { "type": "integer" },
                "sets_minted": { "type": "integer" },
                "fees_accrued": { "type": "integer" },
                "lp_claimed": { "type": "boolean" },
                "status": { "enum": ["open", "resolved_yes", "resolved_no", "void"] }
              }
            }
          ]
        },
        "positions": {
          "type": "object",
          "required": ["creator", "trader", "treasury"],
          "additionalProperties": false,
          "properties": {
            "creator": { "$ref": "#/$defs/position" },
            "trader": { "$ref": "#/$defs/position" },
            "treasury": { "$ref": "#/$defs/position" }
          }
        },
        "balances": {
          "type": "object",
          "required": ["creator", "trader", "treasury", "core"],
          "additionalProperties": false,
          "properties": {
            "creator": { "type": "integer" },
            "trader": { "type": "integer" },
            "treasury": { "type": "integer" },
            "core": { "type": "integer" }
          }
        },
        "resolver_state": {
          "enum": ["Unconfigured", "SignersPending", "Finalized", "Expired", "Disputed", "Other"]
        },
        "trace_count": { "type": "integer", "minimum": 0 },
        "market_trace_count": { "type": "integer", "minimum": 0 }
      }
    },
    "position": {
      "type": "object",
      "required": ["yes", "no"],
      "additionalProperties": false,
      "properties": {
        "yes": { "type": "integer", "minimum": 0 },
        "no": { "type": "integer", "minimum": 0 }
      }
    },
    "resolution_mode": {
      "description": "Resolution mode exercised by a fixture: price, signer, hybrid, invalid or void.",
      "enum": ["price", "signer", "hybrid", "invalid", "void"]
    },
    "resolution_path": {
      "description": "Guardian/fallback path taken to reach the resolution: primary, guardian, fallback or none.",
      "enum": ["primary", "guardian", "fallback", "none"]
    },
    "resolution_event_kind": {
      "description": "Event kinds emitted across the resolution lifecycle. price/signer/hybrid/invalid/void are mode markers; guardian/fallback are path markers; the remainder are lifecycle transitions.",
      "enum": [
        "price",
        "signer",
        "hybrid",
        "invalid",
        "void",
        "guardian",
        "fallback",
        "configured",
        "signers_pending",
        "finalized",
        "expired",
        "disputed",
        "resolved",
        "redeemed",
        "remainder_claimed"
      ]
    },
    "resolution_event": {
      "type": "object",
      "required": ["seq", "kind", "time"],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic sequence number; the decoder must flag gaps and out-of-order events."
        },
        "kind": { "$ref": "#/$defs/resolution_event_kind" },
        "time": { "$ref": "#/$defs/time" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "actor": { "$ref": "#/$defs/actor" },
        "amount": { "type": "integer", "minimum": 0 },
        "resolver_state": {
          "enum": ["Unconfigured", "SignersPending", "Finalized", "Expired", "Disputed", "Other"]
        }
      }
    },
    "resolution_events": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered resolution-lifecycle events. Sanitized: no addresses, hashes or signatures; only deterministic scalar fields.",
      "items": { "$ref": "#/$defs/resolution_event" }
    },
    "resolution_fixture": {
      "type": "object",
      "required": ["name", "mode", "path", "events", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Stable fixture identifier, e.g. price_primary or signer_guardian."
        },
        "mode": { "$ref": "#/$defs/resolution_mode" },
        "path": { "$ref": "#/$defs/resolution_path" },
        "events": { "$ref": "#/$defs/resolution_events" },
        "expected": {
          "type": "object",
          "required": ["resolver_state", "market_status"],
          "additionalProperties": false,
          "description": "Final state the decoder must reconstruct from events.",
          "properties": {
            "resolver_state": {
              "enum": ["Unconfigured", "SignersPending", "Finalized", "Expired", "Disputed", "Other"]
            },
            "market_status": { "enum": ["open", "resolved_yes", "resolved_no", "void"] },
            "outcome": { "$ref": "#/$defs/outcome" }
          }
        }
      }
    }
  }
}
